#!/bin/sh
# Versioned git hooks: enable once per clone with
#   git config core.hooksPath .githooks
# Runs the Known Pitfalls checks (a second or two). Bypass in an emergency
# with `git commit --no-verify` — CI runs the same checks anyway.
exec python3 "$(git rev-parse --show-toplevel)/scripts/check_pitfalls.py"
