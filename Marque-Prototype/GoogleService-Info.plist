<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SETUP REQUIRED
  ──────────────
  1. Create a Firebase project at https://console.firebase.google.com
  2. Add an iOS app with your bundle ID (com.yourcompany.Marque-Prototype)
  3. Download the real GoogleService-Info.plist from the Firebase console
  4. Replace this file entirely with the downloaded one
  5. Add the file to your Xcode target: drag it into the Project Navigator
     and check "Add to target: Marque-Prototype"
  6. Add the Firebase iOS SDK via Xcode → File → Add Package Dependencies
     URL: https://github.com/firebase/firebase-ios-sdk
     Required products: FirebaseAuth, FirebaseCore
-->
<plist version="1.0">
<dict>
    <key>CLIENT_ID</key>
    <string>REPLACE_WITH_YOUR_CLIENT_ID</string>
    <key>REVERSED_CLIENT_ID</key>
    <string>REPLACE_WITH_YOUR_REVERSED_CLIENT_ID</string>
    <key>API_KEY</key>
    <string>REPLACE_WITH_YOUR_API_KEY</string>
    <key>GCM_SENDER_ID</key>
    <string>REPLACE_WITH_YOUR_GCM_SENDER_ID</string>
    <key>PLIST_VERSION</key>
    <string>1</string>
    <key>BUNDLE_ID</key>
    <string>REPLACE_WITH_YOUR_BUNDLE_ID</string>
    <key>PROJECT_ID</key>
    <string>REPLACE_WITH_YOUR_PROJECT_ID</string>
    <key>STORAGE_BUCKET</key>
    <string>REPLACE_WITH_YOUR_STORAGE_BUCKET</string>
    <key>IS_ADS_ENABLED</key>
    <false/>
    <key>IS_ANALYTICS_ENABLED</key>
    <false/>
    <key>IS_APPINVITE_ENABLED</key>
    <true/>
    <key>IS_GCM_ENABLED</key>
    <true/>
    <key>IS_SIGNIN_ENABLED</key>
    <true/>
    <key>GOOGLE_APP_ID</key>
    <string>REPLACE_WITH_YOUR_GOOGLE_APP_ID</string>
</dict>
</plist>
